# Bootstrap tmux plugin manager for the tmux config.
# Also install tmux-powerkit rather than letting tpm do it itself as the
# submodules cause issues with tpm's bootstrapping
_tmux_plugins_dir="$HOME/.tmux/plugins"
_tmux_tpm_dir="$_tmux_plugins_dir/tpm"
_tmux_powerkit_dir="$_tmux_plugins_dir/tmux-powerkit"
if [[ ! -x "$_tmux_tpm_dir/tpm" ]]; then
  print -P "%F{33}Installing tmux plugin manager (%F{220}tmux-plugins/tpm%F{33})...%f"
  command mkdir -p "$_tmux_plugins_dir"
  if command git clone --depth 1 https://github.com/tmux-plugins/tpm "$_tmux_tpm_dir"; then
    print -P "%F{34}TPM installation successful.%f"
    if [[ ! -f "$_tmux_powerkit_dir/tmux-powerkit.tmux" ]]; then
      print -P "%F{33}Installing tmux PowerKit (%F{220}fabioluciano/tmux-powerkit%F{33})...%f"
      command git clone --depth 1 https://github.com/fabioluciano/tmux-powerkit "$_tmux_powerkit_dir" \
        && print -P "%F{34}PowerKit installation successful.%f" \
        || print -P "%F{160}PowerKit installation failed.%f"
    fi
    [[ -x "$_tmux_tpm_dir/bin/install_plugins" ]] && "$_tmux_tpm_dir/bin/install_plugins"
  else
    print -P "%F{160}TPM installation failed.%f"
  fi
elif [[ ! -f "$_tmux_powerkit_dir/tmux-powerkit.tmux" ]]; then
  print -P "%F{33}Installing tmux PowerKit (%F{220}fabioluciano/tmux-powerkit%F{33})...%f"
  command git clone --depth 1 https://github.com/fabioluciano/tmux-powerkit "$_tmux_powerkit_dir" \
    && print -P "%F{34}PowerKit installation successful.%f" \
    || print -P "%F{160}PowerKit installation failed.%f"
  [[ -x "$_tmux_tpm_dir/bin/install_plugins" ]] && "$_tmux_tpm_dir/bin/install_plugins"
elif [[ ! -d "$_tmux_plugins_dir/tmux-yank" && -x "$_tmux_tpm_dir/bin/install_plugins" ]]; then
  "$_tmux_tpm_dir/bin/install_plugins"
fi
unset _tmux_plugins_dir _tmux_tpm_dir _tmux_powerkit_dir

