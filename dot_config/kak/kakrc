# Plugin-specific fixes must be defined before the bundle loads them.
hook global User "bundle-loaded=kakoune-cargo" %{
  try %{ remove-hooks global cargo-compiler }
  hook -group cargo-compiler global WinSetOption compiler=(?!cargo).* %{
    try %{ remove-highlighter window/cargo }
    remove-hooks window cargo-hooks
  }
}

hook global User "bundle-loaded=kakoune-mouvre" %{
  try %{ remove-hooks global diff-chunk-highlight }
  hook -group diff-chunk-highlight global WinSetOption filetype=diff %{
    add-highlighter window/diff-chunk ref diff-chunk
  }
  hook -group diff-chunk-highlight global WinSetOption filetype=(?!diff).* %{
    try %{ remove-highlighter window/diff-chunk }
  }

  try %{ remove-hooks global toml-section-highlight }
  hook -group toml-section-highlight global WinSetOption filetype=toml %{
    add-highlighter window/toml-section ref toml-section
  }
  hook -group toml-section-highlight global WinSetOption filetype=(?!toml).* %{
    try %{ remove-highlighter window/toml-section }
  }
}

bundle-theme one.kak https://codeberg.org/raiguard/kak-one.git
bundle-install-hook one.kak %{
  mkdir -p "${kak_config}/colors"
  # Keep the symlink to the repo (not required, but convenient for discovery).
  ln -sf "${kak_opt_bundle_path}/one.kak" "${kak_config}/colors/"
  # Expose actual theme files where Kakoune expects them.
  for file in "${kak_opt_bundle_path}/one.kak/colors/"*.kak; do
    [ -e "$file" ] || continue
    ln -sf "$file" "${kak_config}/colors/$(basename "$file")"
  done
}
bundle-cleaner one.kak %{
  rm -f "${kak_config}/colors/one.kak"
  for file in "${kak_config}/colors/one-"*.kak; do
    [ -e "$file" ] || continue
    rm -f "$file"
  done
}

