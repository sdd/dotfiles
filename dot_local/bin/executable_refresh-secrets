#!/usr/bin/env bash
set -euo pipefail

vault="${OP_VAULT:-Personal}"
host="$(scutil --get LocalHostName 2>/dev/null || hostname -s)"
host="$(echo "$host" | tr '[:upper:]' '[:lower:]')"

if ! command -v op >/dev/null 2>&1; then
  echo "op CLI not found; not updating secrets." >&2
  exit 1
fi

if ! op whoami >/dev/null 2>&1; then
  echo "op not signed in/unlocked; not updating secrets." >&2
  exit 1
fi

secrets_dir="$HOME/.config/secrets"
env_tmpl="$secrets_dir/env.tmpl"
env_file="$secrets_dir/env"

mkdir -p "$secrets_dir"

resolve_field() {
  local item="$1"
  local base_field="$2"
  local specific="op://$vault/$item/${base_field}_${host}"
  local common="op://$vault/$item/$base_field"

  if op read "$specific" >/dev/null 2>&1; then
    echo "$specific"
  else
    echo "$common"
  fi
}

cat > "$env_tmpl" <<EOF_TPL
NPM_TOKEN={{ $(resolve_field "NPM" "token") }}
EOF_TPL

chmod 600 "$env_tmpl"

tmp_env="$(mktemp)"
if ! op inject -i "$env_tmpl" > "$tmp_env"; then
  rm -f "$tmp_env"
  echo "Failed to inject secrets; leaving existing env file unchanged." >&2
  exit 1
fi

mv "$tmp_env" "$env_file"
chmod 600 "$env_file"
