if [ -f "$HOME/.profile" ]; then
  # shellcheck source=/dev/null
  . "$HOME/.profile"
fi

# Keep this last so that no 3rd-party code executed in this file has access to secrets they don't need
if [ -f "$HOME/.config/secrets/env" ]; then
   # shellcheck source=/dev/null
    . "$HOME/.config/secrets/env"
fi
